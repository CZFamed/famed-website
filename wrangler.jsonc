/* Cloudflare Workers 部署配置（静态站点，没有 Worker 脚本）。
   部署命令：npx wrangler@4 deploy

   注意 name 必须和线上已有的 Worker 名字一致，否则会新建一个 Worker
   而不是更新 czfamed.czfamed1.workers.dev。 */
{
  "name": "czfamed",
  "compatibility_date": "2026-09-14",
  "assets": {
    // 本仓库根目录就是网站根目录
    "directory": ".",
    // /about 之类无扩展名路径自动回落到 about.html；目录路径回落 index.html
    "html_handling": "auto-trailing-slash",
    // 找不到的路径返回站点自己的 404.html（与当前线上行为一致）
    "not_found_handling": "404-page"
  }
}
